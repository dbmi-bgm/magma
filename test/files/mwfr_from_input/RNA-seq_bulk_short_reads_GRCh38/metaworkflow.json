      "value": {
        "overall_quality_status_rule": "{freemix_alpha} and {rrna_rate} and {library_complexity} and {exonic_intron_ratio} and {mapping_rate} and {genes_detected} and {intergenic_rate} and {chimeric_rate}",
        "qc_thresholds": [
          {
            "id": "freemix_alpha",
            "metric": "Estimate of Contamination [VerifyBamID2]",
            "operator": "<",
            "pass_target": 0.01,
            "use_as_qc_flag": true,
            "warn_target": 1.0
          },
          {
            "id": "rrna_rate",
            "metric": "rRNA Rate [RNA-SeQC]",
            "operator": "<",
            "pass_target": 0.01,
            "use_as_qc_flag": true,
            "warn_target": 1.0
          },
          {
            "id": "library_complexity",
            "metric": "Estimated Library Complexity [RNA-SeQC]",
            "operator": ">",
            "pass_target": 50000000.0,
            "use_as_qc_flag": true,
            "warn_target": 0.0
          },
          {
            "id": "exonic_intron_ratio",
            "metric": "Exonic/Intron Ratio [RNA-SeQC]",
            "operator": "<",
            "pass_target": 5.0,
            "use_as_qc_flag": true,
            "warn_target": 1000.0
          },
          {
            "id": "mapping_rate",
            "metric": "Mapping Rate [RNA-SeQC]",
            "operator": ">",
            "pass_target": 0.85,
            "use_as_qc_flag": true,
            "warn_target": 0.0
          },
          {
            "id": "genes_detected",
            "metric": "Genes Detected [RNA-SeQC]",
            "operator": ">",
            "pass_target": 25000.0,
            "use_as_qc_flag": true,
            "warn_target": 0.0
          },
          {
            "id": "intergenic_rate",
            "metric": "Intergenic Rate [RNA-SeQC]",
            "operator": "<",
            "pass_target": 0.1,
            "use_as_qc_flag": true,
            "warn_target": 1.0
          },
          {
            "id": "chimeric_rate",
            "metric": "Percentage of Chimeric Reads [RNA-SeQC]",
            "operator": "<",
            "pass_target": 1.0,
            "use_as_qc_flag": true,
            "warn_target": 100.0
          }
        ]
      }
    }
