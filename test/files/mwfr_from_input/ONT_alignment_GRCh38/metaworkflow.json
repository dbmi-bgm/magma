      "argument_type": "file",
      "files": [
        {
          "file": "cfbf7601-7ce1-4cc5-9b1f-dda456052f14"
        }
      ]
    },
    {
      "argument_name": "sample_name",
      "argument_type": "parameter",
      "value_type": "string"
    },
    {
      "argument_name": "library_id",
      "argument_type": "parameter",
      "value_type": "string"
    },
    {
      "argument_name": "preset",
      "argument_type": "parameter",
      "value": "map-ont",
      "value_type": "string"
    },
    {
      "argument_name": "qc_ruleset",
      "argument_type": "QC ruleset",
      "value": {
        "overall_quality_status_rule": "{freemix_alpha} and {mapped} and {mismatch_rate}",
        "qc_thresholds": [
          {
            "id": "freemix_alpha",
            "metric": "Estimate of Contamination [VerifyBamID2]",
            "operator": "<",
            "pass_target": 0.01,
            "use_as_qc_flag": true,
            "warn_target": 1.0
          },
          {
            "id": "mapped",
            "metric": "Percentage of Reads Mapped [Samtools]",
            "operator": ">",
            "pass_target": 97.0,
            "use_as_qc_flag": true,
            "warn_target": 0.0
          },
          {
            "id": "mismatch_rate",
            "metric": "Aligned Bases Mismatch Rate [Picard]",
            "operator": "<",
            "pass_target": 0.01,
            "use_as_qc_flag": true,
            "warn_target": 1.0
          }
        ]
      }
    }
  ],
