            "operator": "<",
            "pass_target": 0.1,
            "use_as_qc_flag": true,
            "warn_target": 100.0
          },
          {
            "id": "sequence_length",
            "metric": "Sequence Length [FastQC]",
            "operator": "is_type",
            "pass_target": "int",
            "use_as_qc_flag": true,
            "warn_target": "int"
          }
        ]
      }
    }
