      "value": {
        "overall_quality_status_rule": "{freemix_alpha} and {duplicates} and {mapped} and {mapped_proper_pairs} and {mismatch_rate} and {insert_size}",
        "qc_thresholds": [
          {
            "id": "freemix_alpha",
            "metric": "Estimate of Contamination [VerifyBamID2]",
            "operator": "<",
            "pass_target": 0.01,
            "use_as_qc_flag": true,
            "warn_target": 1.0
          },
          {
            "id": "duplicates",
            "metric": "Percentage of Reads Duplicated [Samtools]",
            "operator": "<",
            "pass_target": 15.0,
            "use_as_qc_flag": true,
            "warn_target": 100.0
          },
          {
            "id": "mapped",
            "metric": "Percentage of Reads Mapped [Samtools]",
            "operator": ">",
            "pass_target": 97.0,
            "use_as_qc_flag": true,
            "warn_target": 0.0
          },
          {
            "id": "mapped_proper_pairs",
            "metric": "Percentage of Properly Paired Reads [Samtools]",
            "operator": ">",
            "pass_target": 92.0,
            "use_as_qc_flag": true,
            "warn_target": 0.0
          },
          {
            "id": "mismatch_rate",
            "metric": "Aligned Bases Mismatch Rate [Picard]",
            "operator": "<",
            "pass_target": 0.008,
            "use_as_qc_flag": true,
            "warn_target": 1.0
          },
          {
            "id": "insert_size",
            "metric": "Mean Insert Size [Picard]",
            "operator": ">",
            "pass_target": 250.0,
            "use_as_qc_flag": true,
            "warn_target": 0.0
          }
        ]
      }
    }
  ],
